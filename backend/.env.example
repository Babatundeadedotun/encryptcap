# ═══════════════════════════════════════════════════════════════════════════
#  EncryptCap — API environment
#  Copy this file to `.env` (same folder) and fill in the values.
#      cp .env.example .env
#  `.env` is gitignored. Never commit real credentials.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. DATABASE  — the only value you need to run locally
# ───────────────────────────────────────────────────────────────────────────

# MongoDB Atlas (production and shared development):
#   1. cloud.mongodb.com → your cluster → "Connect" → "Drivers"
#   2. Copy the string, replace <db_password> with the real password
#   3. Add your database name before the "?" — here, encryptcap
#   4. Network Access → allow your IP (0.0.0.0/0 while testing; tighten later)
#
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/encryptcap?retryWrites=true&w=majority
#
# Local MongoDB instead:
#   mongodb://127.0.0.1:27017/encryptcap
#
# If the password contains @ : / ? # [ ] or %, URL-encode it (@ becomes %40).
#
# Leave this empty and the API starts a throwaway in-memory database so you can
# look around — that data is discarded when the process stops.
MONGODB_URI=


# ───────────────────────────────────────────────────────────────────────────
#  2. SERVER
# ───────────────────────────────────────────────────────────────────────────

PORT=4000

# development | production
# In production the server refuses to boot without a real JWT_SECRET and
# MONGODB_URI, and it stops auto-seeding demo data.
NODE_ENV=development


# ───────────────────────────────────────────────────────────────────────────
#  3. SESSIONS
# ───────────────────────────────────────────────────────────────────────────

# Signs the login cookie. `npm run setup` generates one for you.
# Generate your own with:  openssl rand -hex 48
# Changing it logs every user out. Use a DIFFERENT value in production.
JWT_SECRET=

# How long a login lasts: 30m, 12h, 7d, 30d
JWT_EXPIRES_IN=7d


# ───────────────────────────────────────────────────────────────────────────
#  4. WHO MAY CALL THIS API  (CORS)
# ───────────────────────────────────────────────────────────────────────────

# The frontend's origin. Comma-separate several — no trailing slashes.
#
#   local dev:        http://localhost:5173
#   Netlify preview:  https://deploy-preview-1--yoursite.netlify.app
#   Netlify live:     https://encryptcap.netlify.app
#   custom domain:    https://app.encryptcap.com
#
# Anything not listed here is refused, so add your Netlify URL before you
# deploy or the browser will block every request.
CLIENT_ORIGIN=http://localhost:5173


# ───────────────────────────────────────────────────────────────────────────
#  5. SEEDED LOGINS
# ───────────────────────────────────────────────────────────────────────────

# The manager account created when an empty database is seeded.
# CHANGE THE PASSWORD before anything is reachable from the internet.
SEED_MANAGER_EMAIL=manager@encryptcap.com
SEED_MANAGER_PASSWORD=ChangeMe!2026

# Password shared by the 30 demo investor accounts. Demo data only.
SEED_INVESTOR_PASSWORD=Investor!2026

# ---------------------------------------------------------------------------
# BREAK-GLASS PASSWORD RESET  — normally empty
#
# Set this to a new password (10+ characters) and redeploy, and the manager
# account's password becomes that value on boot. Use it when the password is
# lost and no recovery code is left.
#
# DELETE IT AGAIN once you are back in: while it is set, every deploy resets
# the password to it and signs out every device.
MANAGER_PASSWORD_RESET=


# ═══════════════════════════════════════════════════════════════════════════
#  BELOW HERE IS NOT WIRED UP YET
#  These are the integrations the stubbed features will need. Nothing reads
#  them today, so the app runs fine with all of them blank.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  6. EMAIL  — for the research newsletter and password notices
# ───────────────────────────────────────────────────────────────────────────

# Where investor enquiries and capital requests are sent. This address is the
# one the site's mailto: links are addressed to.
CONTACT_EMAIL=invest@encryptcap.com

# Pick one provider and fill in its key.
#   Resend      https://resend.com/api-keys
#   SendGrid    https://app.sendgrid.com/settings/api_keys
#   Mailgun     https://app.mailgun.com/settings/api_security
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Or plain SMTP instead of a provider API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From: address on outbound mail. Must be a domain you have verified.
MAIL_FROM="EncryptCap <no-reply@encryptcap.com>"


# ───────────────────────────────────────────────────────────────────────────
#  7. FILE STORAGE  — for research PDF/PPTX uploads
# ───────────────────────────────────────────────────────────────────────────

# Uploads currently land in backend/uploads/ on local disk. That works on your
# machine but is WIPED on every deploy on Render, Railway, Fly and Heroku.
# Move to object storage before relying on it in production.
#
#   AWS S3          https://console.aws.amazon.com/s3
#   Cloudflare R2   https://dash.cloudflare.com → R2
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

#   Cloudinary      https://console.cloudinary.com
CLOUDINARY_URL=


# ───────────────────────────────────────────────────────────────────────────
#  8. OPERATIONS
# ───────────────────────────────────────────────────────────────────────────

# Error tracking — https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=

# Public base URL of this API, used to build absolute links inside emails
# and PDFs. No trailing slash.
#   local:  http://localhost:4000
#   live:   https://encryptcap-api.onrender.com
API_PUBLIC_URL=http://localhost:4000
