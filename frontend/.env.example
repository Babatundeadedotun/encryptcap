# ═══════════════════════════════════════════════════════════════════════════
#  EncryptCap — web app environment
#  Copy this file to `.env` (same folder) and fill in the values.
#      cp .env.example .env
#
#  IMPORTANT: everything here is compiled into the JavaScript bundle and is
#  therefore PUBLIC. Never put a password, API secret or database URI in this
#  file — those belong in backend/.env. Vite only exposes VITE_-prefixed names,
#  which is a guardrail, not a guarantee.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. LOCAL DEVELOPMENT
# ───────────────────────────────────────────────────────────────────────────

# Where `npm run dev` forwards /api requests. Only change this if you moved the
# API off port 4000. Because the dev server proxies, the browser sees a single
# origin and the login cookie stays first-party — no CORS involved.
VITE_API_TARGET=http://localhost:4000


# ───────────────────────────────────────────────────────────────────────────
#  2. PRODUCTION API LOCATION
# ───────────────────────────────────────────────────────────────────────────

# Where the built site sends its API calls.
#
# LEAVE THIS EMPTY if the API answers on the same domain as the site (for
# example behind a Netlify redirect, see netlify.toml). Same-origin keeps the
# session cookie first-party, which is the more reliable setup — Safari and
# Brave block third-party cookies by default.
#
# Set it to an absolute URL only when the API lives on another domain:
#   https://encryptcap-api.onrender.com
#   https://api.encryptcap.com
#
# If you do set it, you must also:
#   - add this site's URL to CLIENT_ORIGIN in backend/.env
#   - serve both over HTTPS, or the cookie will be dropped
# No trailing slash.
VITE_API_BASE=


# ───────────────────────────────────────────────────────────────────────────
#  3. SITE IDENTITY
# ───────────────────────────────────────────────────────────────────────────

# Canonical public URL, used for share links and SEO tags. No trailing slash.
#   https://encryptcap.netlify.app
#   https://www.encryptcap.com
VITE_SITE_URL=http://localhost:5173

# The address the "Open an account" and capital-request forms compose mail to.
VITE_CONTACT_EMAIL=invest@encryptcap.com

# Shown in the footer and on the About page.
VITE_COMPANY_RC=7363337
VITE_COMPANY_ADDRESS=Post Service Estate, Ojo, Lagos, Nigeria

# Add before launch — the About page currently says "Add before launch".
VITE_CONTACT_PHONE=
VITE_WHATSAPP_URL=


# ═══════════════════════════════════════════════════════════════════════════
#  BELOW HERE IS NOT WIRED UP YET
#  Scaffolded so the names are settled. Nothing reads them today.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  4. ANALYTICS
# ───────────────────────────────────────────────────────────────────────────

# Google Analytics 4 — analytics.google.com → Admin → Data Streams
VITE_GA_MEASUREMENT_ID=

# Plausible (privacy-friendly alternative) — the domain you registered
VITE_PLAUSIBLE_DOMAIN=

# Browser error tracking — sentry.io → Client Keys (DSN)
VITE_SENTRY_DSN=


# ───────────────────────────────────────────────────────────────────────────
#  5. SOCIAL LINKS  (footer)
# ───────────────────────────────────────────────────────────────────────────

VITE_TWITTER_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
